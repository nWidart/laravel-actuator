{
    "name": "nwidart/laravel-actuator",
    "description": "Production-ready monitoring endpoints for Laravel, modelled on Spring Boot Actuator.",
    "keywords": [
        "laravel",
        "actuator",
        "health",
        "health-check",
        "kubernetes",
        "metrics",
        "monitoring",
        "prometheus",
        "spring-boot-admin"
    ],
    "homepage": "https://github.com/nwidart/laravel-actuator",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Widart",
            "email": "n.widart@gmail.com",
            "homepage": "https://nwidart.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nwidart/laravel-metrics": "^0.3 || ^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "predis/predis": "^2.3|^3.0"
    },
    "suggest": {
        "ext-redis": "Required by the Redis health indicator and the Redis metrics store when using the phpredis client.",
        "predis/predis": "Required by the Redis health indicator and the Redis metrics store when using the predis client."
    },
    "autoload": {
        "psr-4": {
            "Nwidart\\Actuator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nwidart\\Actuator\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html build/coverage",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nwidart\\Actuator\\ActuatorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
